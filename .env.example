# Server-only variables for Vercel. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-rotated-service-role-key

# Transactional email (server-only). Verify megcredit.com in Resend first.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL=MEG Credit <notificaciones@megcredit.com>
CONTACT_MANAGER_EMAIL=manager@megcredit.com

# Client portal (server-only unless prefixed VITE_).
# PORTAL_ADMIN_TOKEN authorizes POST /api/portal/admin-invite. Generate with
# `openssl rand -hex 32` and keep it only in Vercel env vars / your own secrets tool.
PORTAL_ADMIN_TOKEN=generate-a-long-random-token
# Separate HMAC secret for hashing client IPs in portal rate limiting. If unset,
# falls back to SUPABASE_SERVICE_ROLE_KEY.
PORTAL_SESSION_SECRET=generate-another-long-random-secret
SUPABASE_STORAGE_BUCKET=megcredit-client-documents

# Public (safe to expose in the browser): needed so the portal can upload files
# directly to Supabase Storage using the short-lived signed URLs the backend issues.
# The anon key is meant to be public -- it grants nothing on its own because RLS on
# every megcredit_ table and the client-documents bucket revokes all anon/authenticated
# access. Never put SUPABASE_SERVICE_ROLE_KEY in a VITE_-prefixed variable.
VITE_SUPABASE_ANON_KEY=your-project-anon-key

# Admin portal + Stripe billing (server-only). PORTAL_ADMIN_TOKEN (above) is also
# reused to protect POST /api/admin/bootstrap-staff, the one-time endpoint used to
# create each staff member's login (there is no self-serve "invite staff" UI).
# STRIPE_SECRET_KEY: from the Stripe dashboard (use a sk_test_... key while testing).
# STRIPE_WEBHOOK_SECRET: from `stripe listen` locally, or the webhook endpoint's
# signing secret in the Stripe dashboard once deployed. No publishable key or
# Stripe.js is needed -- payment is a redirect to hosted Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Encrypts the client's credit-monitoring credentials (api/_lib/crypto.js, AES-256-GCM)
# before they're written to megcredit_client_credit_monitoring. Must decode to exactly
# 32 bytes. Generate with: openssl rand -base64 32
PORTAL_CREDENTIAL_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
