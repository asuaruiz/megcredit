{"nodes": [{"id": "agents_project_operating_notes", "label": "Project Operating Notes", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_shared_supabase_isolation", "label": "Shared Supabase Tenant Isolation", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Supabase project is shared with other websites, so database work must be additive, use the megcredit_ prefix, and never affect unrelated objects or data."}, {"id": "agents_service_role_server_boundary", "label": "Service Role Server Boundary", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Supabase service-role key must remain server-side and must never appear in browser code or VITE_-prefixed variables."}, {"id": "agents_portal_app_auth", "label": "Portal Application-Level Authentication", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_staff_auth_separation", "label": "Staff Authentication Separation", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staff accounts use a separate table, session, and cookie so a client-authentication bug cannot escalate to staff access."}, {"id": "agents_credit_monitoring_encryption_exception", "label": "Encrypted Credit Monitoring Credential Exception", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients deliberately submit monitoring credent